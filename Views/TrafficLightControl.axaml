<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IPC.Views.TrafficLightControl"
             Width="24"
             Height="24">
  <Ellipse x:Name="LightCircle"
           Width="12"
           Height="12"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           Fill="Gray"
           Stroke="Black"
           StrokeThickness="0.5" />
</UserControl>
